<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- LibreHU: the car's name, make, model and addresses from LibreHU-service (signature permission). -->
    <uses-permission android:name="org.librehu.permission.VEHICLE" />
    <!-- LibreHU: commands from LibreHU-service (night from the headlights), apps signed with the LibreHU key only. -->
    <permission
        android:name="${applicationId}.permission.CONFIGURE"
        android:protectionLevel="signature" />
    <!-- LibreHU apps (same signing key): LibreHU-service's bridge reads and changes CarPlay's settings for the phone app. -->
    <permission
        android:name="org.librehu.permission.BRIDGE"
        android:protectionLevel="signature" />
    <!-- LibreHU: launcher theme provider (Android 11+ package visibility). -->
    <queries>
        <provider android:authorities="org.librehu.launcher.theme" />
        <provider android:authorities="org.librehu.service.vehicle" />
    </queries>

    <application>

        <activity
            android:name="com.shilapi.xcertplay.CarPlayHostActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay.CarPlay"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <activity
            android:name="com.shilapi.xcertplay.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Xcertplay" />

        <activity
            android:name="com.shilapi.xcertplay.ImageCropActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay" />

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Settings pages for LibreHU's phone app, read and changed by LibreHU-service's bridge (librehu/bridge). -->
        <provider
            android:name="com.shilapi.xcertplay.librehu.bridge.BridgeProvider"
            android:authorities="${applicationId}.bridge"
            android:exported="true"
            android:permission="org.librehu.permission.BRIDGE" />
    </application>

</manifest>
